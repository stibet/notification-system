APP_NAME="Notification Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

DB_CONNECTION=sqlite

QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=array

